{
  "name": "dsh-tool-gateway",
  "version": "0.1.1",
  "description": "把 DSH 的工具目录收成三个元工具：find_tools 查、call_tool 调、call_tools 批量调；其余工具不出现在模型可见目录里，但仍然可被调用",
  "author": "leolee9086",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolee9086/dsh-tool-gateway.git"
  },
  "homepage": "https://github.com/leolee9086/dsh-tool-gateway#readme",
  "bugs": {
    "url": "https://github.com/leolee9086/dsh-tool-gateway/issues"
  },
  "type": "module",
  "license": "MIT",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/",
    "prepack": "pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.3",
    "minisearch": "^7.2.0",
    "pinyin-pro": "^3.29.4"
  }
}
